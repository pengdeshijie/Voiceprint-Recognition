<view class="home-container"><view class="top-header"><view class="greeting"><text class="h1">你好，{{a}}</text><text class="h2">今天想去哪里观测？</text></view><image class="avatar-small" src="{{b}}" mode="aspectFill"></image></view><view class="swiper-box"><swiper class="card-swiper" circular autoplay interval="4000" duration="500" indicator-dots indicator-active-color="#ffffff" indicator-color="rgba(255,255,255,0.5)"><swiper-item wx:for="{{c}}" wx:for-item="item" wx:key="c" class="swiper-item"><view class="swiper-content"><image class="swiper-img" src="{{item.a}}" mode="aspectFill"></image><view class="img-mask"><text class="img-text">{{item.b}}</text></view></view></swiper-item></swiper></view><view class="stats-section"><view class="stat-card"><view class="stat-left"><text class="stat-label">{{d}}</text><text class="stat-num">{{e}}</text></view><view class="stat-right"><view class="circle-icon">🕊️</view></view></view></view><view class="section-title">快捷功能</view><view class="grid-menu"><view class="grid-item" bindtap="{{f}}"><view class="icon-box blue-bg">📦</view><text>管理库存</text></view><view class="grid-item" bindtap="{{g}}"><view class="icon-box green-bg">🗺️</view><text>查看地图</text></view><view class="grid-item" bindtap="{{h}}"><view class="icon-box orange-bg">✏️</view><text>快速记录</text></view><view class="grid-item" bindtap="{{i}}"><view class="icon-box purple-bg">🎙️</view><text>语音记事</text></view><view class="grid-item" bindtap="{{j}}"><view class="icon-box red-bg">📷</view><text>拍照识别</text></view></view></view>