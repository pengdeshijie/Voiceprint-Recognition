<view class="container"><view class="status-bar"><text class="status-text">{{a}}</text></view><view class="result-box"><block wx:if="{{r0}}"><textarea class="result-area" placeholder="长按下方按钮说话..." maxlength="-1" value="{{b}}" bindinput="{{c}}"/></block></view><view class="btn-group"><view class="{{['mic-btn', d && 'recording']}}" bindtouchstart="{{e}}" bindtouchend="{{f}}" bindmousedown="{{g}}" bindmouseup="{{h}}"><text class="mic-icon">🎙️</text></view><text class="tip">长按说话 (手机端生效)</text><button class="save-btn" type="primary" bindtap="{{i}}" disabled="{{j}}">保存到仓库</button></view></view>