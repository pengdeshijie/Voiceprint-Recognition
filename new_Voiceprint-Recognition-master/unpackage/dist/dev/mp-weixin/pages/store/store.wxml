<view class="container"><view class="header-title">📦 {{a}}的仓库</view><view wx:if="{{b}}" class="empty-tip"><text>请先登录后查看数据</text><button size="mini" type="primary" style="margin-top:20px" bindtap="{{c}}">去登录</button></view><view wx:elif="{{d}}" class="empty-tip"><image src="{{e}}" style="width:50px;height:50px;opacity:0.5;margin-bottom:10px"></image><view>暂无记录，快去添加吧~</view></view><view wx:else class="list-box"><view wx:for="{{f}}" wx:for-item="item" wx:key="f" class="card" bindtap="{{item.g}}"><image class="card-img" src="{{item.a}}" mode="aspectFill"></image><view class="card-content"><view class="card-top"><text class="card-title">{{item.b}}</text></view><text class="card-desc">{{item.c}}</text><text class="card-time">{{item.d}}</text></view><view class="delete-btn" catchtap="{{item.e}}"><text>🗑️</text></view></view></view><view wx:if="{{g}}" class="add-btn" bindtap="{{h}}"><text>+</text></view></view>